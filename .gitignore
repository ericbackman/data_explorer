# Secrets (never commit API keys / credentials)
.env
*.env
.eric.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.so
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Claude Code — local/machine-specific settings (not for sharing)
.claude/settings.local.json

# VSCode — local/user-specific settings
.vscode/

# Cached API data
.cache/
nba_site/investigations/*/.cache.json

# OS
.DS_Store
Thumbs.db

# Per-domain DB build artifacts — db + raw API cache (regenerable; never commit)
nba/data/
pga/data/
nfl/data/
osrs/data/
sumo/data/

# Personal betting-account exports (folded in from betting_stuff 2026-07-01) —
# NOT regenerable, but PERSONAL ACCOUNT DATA: keep local only, NEVER commit.
betting/raw/
bet365_*.json
fanduel_*.json

# Betting automation runtime artifacts (browser sessions/screenshots stay local)
betting/.browser_data*/
betting/screenshots/

# Generated dashboard artifacts (regenerable from db_dashboard.py)
db_dashboard.html
db_dashboard.widget.html

# Run logs
*.log

# SQLite WAL/SHM sidecars (transient; never commit)
*.db-wal
*.db-shm
*.db-journal

# Generated NBA data & artifacts (regenerable from scripts — never commit)
raw_data/
*.db
*_pbp.csv
nba_quarter_trends_2025_26.csv
max_deficit_situations.csv
playoff_max_deficit_situations.csv
q3_comeback_situations.csv
q3_backtest_bets.csv

# Generated charts (regenerable)
*.png

# trades — generated flowcharts/boards (regenerable via `python -m trades`)
trades/*.svg
trades/*.html

# essays — generated narration / voice / video media (regenerable via the tts_*
# stages + `python -m essays.compose`; large personal-render artifacts, never commit).
# Leading **/ so these keep matching after the tree moved to v1/essays/ — the old
# anchored `essays/assets/...` form silently stopped matching and left ~150 MB of
# media untracked-but-not-ignored, one `git add -A` from entering history.
**/essays/assets/*.mp3
**/essays/assets/*.wav
**/essays/assets/*.mp4
**/essays/assets/voice_samples/
**/essays/assets/narration_parts*/
nhl/data/
mlb/data/

# BigQuery staging: Parquet regenerated by bigquery/export_to_parquet.py from
# nba.db, ~250 MB and reproducible in minutes.
#
# Matched by EXTENSION, not as `bigquery/export/`, deliberately. A bare directory
# ignore is what silently swallowed the entire filedrop Worker source in
# wild-collective (fixed 2026-08-29) — the rule was written for media, then code
# was added to the same directory and vanished from git. Ignoring the artifacts
# means anything else that lands in there stays visible.
bigquery/export/*.parquet

# Local HTML renders of the almanac study. The markdown is the source of truth
# (and currently richer than any render); a committed copy only invites drift.
almanac/*.html
